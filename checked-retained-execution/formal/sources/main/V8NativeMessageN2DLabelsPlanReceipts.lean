import V8NativeMessageN2DLabelsPlanVisits
import V8NativeMessageN2DLabelsPlanFormat

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 1500000
set_option linter.unusedSectionVars false

/-! Join the actual word-level certificate and the actual visit
paths. Orders can be supplied by the source tape, or chosen
noncomputably from the finite graph for a semantic instantiation. -/
namespace V8NativeMessage.N2DLabels
open scoped Classical Polynomial
open Polynomial J6ActiveRun J6R9Recursive J6R10Reachable J6R10Repack
open J6R11Blueprint J6R12Blueprint J1PPrinted

variable {f : ℤ[X]} {ell : ℕ}

abbrev OrderInputs (S : Params (f:=f) (ell:=ell)) (Δ : ℕ) :=
  ∀ c : Call (PhysicalHost f ell), Ready S Δ c → HostOrders c.host

def formatsOfOrders {S : Params (f:=f) (ell:=ell)} {Δ : ℕ} (ord : OrderInputs S Δ) :
    Full64PlanInputs S Δ :=
  fun c d => formatOfHost c (ord c d)

noncomputable def logicalCertified (S : Params (f:=f) (ell:=ell)) (Δ : ℕ) :
    CertifiedSelector S Δ :=
  full64Selector (logicalFormats S Δ)

section LastStep
variable {Host Mode : Type*} [Fintype Mode] [DecidableEq Mode]
  {S : Shape Host Mode} {Value : ℕ→Type*}

/-- Recover the actual predecessor occurrence at a nonroot visit.
The final address remains unchanged. -/
theorem actual_nonroot_last_step {P : Program S Value} {root c : Call Host}
    (v : ActualVisit P root c) (ne : c≠root) :
    ∃ (a : Call Host) (_prior : ActualVisit P root a),
      S.cutoff<a.edges ∧ ∃ w : Address S a, c=P.child a w := by
  cases v with
  | base => exact (ne rfl).elim
  | down prior live w => exact ⟨_,prior,live,w,rfl⟩
end LastStep

variable {s C : ℕ}
local notation "SP" => printedParams (f:=f) (ell:=ell) s
local notation "D" => sourceDelta s

/-- Exact full-64 trace and its collision theorem for every active
visit of this plan on the same selected chart. -/
theorem actual_source_visit_full64 (inputs : Full64PlanInputs SP D)
    (root : Call (PhysicalHost f ell)) (hf : f.Monic)
    [DecidableEq (Envelope (N (forget (full64Selector inputs)))
      (Childs (forget (full64Selector inputs))) root)]
    (cfg : RootBounds s C f) (seed : Stable s C root) {c : Call (PhysicalHost f ell)}
    (v : ActualVisit (sourceBlueprint (forget (full64Selector inputs)) root hf).program root c)
    (live : (SP).cutoff<c.edges) :
    letI := c.host.finiteEdge
    letI := c.host.finiteRow
    letI := c.host.finiteCol
    let d := active_source_reachable_ready (full64Selector inputs) root hf cfg seed v.reached live
    let F : CallFormat SP c := inputs c d
    let P := packing (forget (full64Selector inputs)) d
    CollisionCertified D P ∧ RoundsExactly P ∧
      F.run.result.2=F.order.map (fun a=>F.format.label (wordsOf P a)) ∧
      F.run.result.1=F.format.graph (fun a=>some (wordsOf P a)) ∧
      (F.run.steps : ℕ)≤F.fee :=
  full64_selected_receipt inputs
    (active_source_reachable_ready (full64Selector inputs) root hf cfg seed v.reached live)

noncomputable abbrev pinnedFull64 (inputs : Full64PlanInputs SP D)
    (root : Call (PhysicalHost f ell))
    (fixed : CertifiedPacking root.host.network ((SP).levelBits root.depth) D) :
    CertifiedSelector SP D := pinCertified (full64Selector inputs) root fixed

/-- A run with an externally certified tied root need not claim that
root was generated by the ordinary greedy driver. Every active nonroot
step retains its own exact original full-64 tape. -/
theorem pinned_actual_source_nonroot_full64 (inputs : Full64PlanInputs SP D)
    (root : Call (PhysicalHost f ell)) (hf : f.Monic)
    (fixed : CertifiedPacking root.host.network ((SP).levelBits root.depth) D)
    [DecidableEq (Envelope (N (forget (pinnedFull64 inputs root fixed)))
      (Childs (forget (pinnedFull64 inputs root fixed))) root)]
    (cfg : RootBounds s C f) (seed : Stable s C root) {c : Call (PhysicalHost f ell)}
    (v : ActualVisit (sourceBlueprint (forget (pinnedFull64 inputs root fixed)) root hf).program root c)
    (live : (SP).cutoff<c.edges) (notRoot : c≠root) :
    letI := c.host.finiteEdge
    letI := c.host.finiteRow
    letI := c.host.finiteCol
    let d := active_source_reachable_ready (pinnedFull64 inputs root fixed) root hf cfg seed v.reached live
    let F : CallFormat SP c := inputs c d
    let P := packing (forget (pinnedFull64 inputs root fixed)) d
    CollisionCertified D P ∧ RoundsExactly P ∧
      F.run.result.2=F.order.map (fun a=>F.format.label (wordsOf P a)) ∧
      F.run.result.1=F.format.graph (fun a=>some (wordsOf P a)) ∧
      (F.run.steps : ℕ)≤F.fee := by
  letI := c.host.finiteEdge
  letI := c.host.finiteRow
  letI := c.host.finiteCol
  let d := active_source_reachable_ready (pinnedFull64 inputs root fixed) root hf cfg seed v.reached live
  let F : CallFormat SP c := inputs c d
  let P := packing (forget (pinnedFull64 inputs root fixed)) d
  change CollisionCertified D P ∧ RoundsExactly P ∧
      F.run.result.2=F.order.map (fun a=>F.format.label (wordsOf P a)) ∧
      F.run.result.1=F.format.graph (fun a=>some (wordsOf P a)) ∧
      (F.run.steps : ℕ)≤F.fee
  unfold P
  rw [pin_certified_other (full64Selector inputs) root fixed d notRoot]
  exact full64_selected_receipt inputs d

/-- No format-family argument in the semantic version. This does not
make the arbitrary logical finite orders paid byte computation. -/
theorem logical_source_visit_collision (root : Call (PhysicalHost f ell)) (hf : f.Monic)
    [DecidableEq (Envelope (N (forget (logicalCertified SP D)))
      (Childs (forget (logicalCertified SP D))) root)]
    (cfg : RootBounds s C f) (seed : Stable s C root) {c : Call (PhysicalHost f ell)}
    (v : ActualVisit (sourceBlueprint (forget (logicalCertified SP D)) root hf).program root c)
    (live : (SP).cutoff<c.edges) :
    CollisionCertified D (packing (forget (logicalCertified SP D))
      (active_source_reachable_ready (logicalCertified SP D) root hf cfg seed v.reached live)) :=
  active_source_visit_collision (logicalCertified SP D) root hf cfg seed v live

#print axioms formatsOfOrders
#print axioms actual_nonroot_last_step
#print axioms actual_source_visit_full64
#print axioms pinned_actual_source_nonroot_full64
#print axioms logical_source_visit_collision
end V8NativeMessage.N2DLabels