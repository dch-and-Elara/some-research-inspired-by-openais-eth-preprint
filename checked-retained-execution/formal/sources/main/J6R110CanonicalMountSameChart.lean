set_option autoImplicit false

set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxHeartbeats 16500000
set_option maxRecDepth 4200
set_option maxSynthPendingDepth 12
set_option Elab.async false

noncomputable section
section Chart
variable {f : ℤ[X]} {ell s C : ℕ} {cfg : RootBounds s C f}
variable {sel : Selector (printedParams (f:=f) (ell:=ell) s) (sourceDelta s)}
variable {r : Call (PhysicalHost f ell)} {hf : f.Monic}

theorem certified_masks_with_the_same_extent_are_identical {e n : ℕ} {fit : n≤2^e}
    (A B : MaskTable e n fit) : A=B := by
  have same := A.certified.trans B.certified.symm
  cases A with
  | mk ar ah =>
    cases B with
    | mk br bh =>
      dsimp only at same
      cases same
      rfl

/-- Both charts must actually certify the same chosen field order and
must have the same extent. Under these exact hypotheses the entire chart,
not merely a numerical answer obtained with it, is identical. -/
theorem actual_certified_charts_are_identical_at_equal_count
    {T : Prepared cfg sel r hf} (A B : MountedChart T) (same : A.count=B.count) : A=B := by
  cases A with
  | mk a fa ta ca =>
    cases B with
    | mk b fb tb cb =>
      dsimp only at same
      subst b
      have eq : ta=tb := certified_masks_with_the_same_extent_are_identical ta tb
      subst tb
      rfl

end Chart
section Exterior
variable {V : Type} [Fintype V]
variable {f : ℤ[X]} {m n base native : ℕ} {plant : Plant V m n}
variable {G : RootShape f m (printedHalf m) base native (printedRankWidth m) plant
  (J6R28GeneratedRootFrame.constantRootWord m)}
variable {ell qr ro co e edgew tc tj key prec tw bw page s C q cw : ℕ}
variable {cfg : RootBounds s C f}
variable {sel : Selector (printedParams (f:=f) (ell:=ell) s) (sourceDelta s)}
variable (X : StableExterior G ell qr ro co e edgew tc tj key prec tw bw)
variable {T : Prepared cfg sel (exteriorChild G ell X.centre X.sample X.group) X.hf}
variable (d : ℕ) (fit : d+1≤2^f.natDegree)
variable (bytes : (canonicalTable f.natDegree (d+1)).result=OldOrderedBytes f.natDegree d fit)
variable (covers : Covers (sel:=sel) (r:=exteriorChild G ell X.centre X.sample X.group) d)
variable (M : OnlineMachine T key prec tw bw page q) (F : RetainedAfter T key prec tw bw page q cw)
variable (layout : ExteriorLayout (T:=T) (page:=page) (cw:=cw) X)
variable (retire : PageJob f ell key prec tw bw page→ℕ) (B : PageBank f ell key prec tw bw page)
variable (own : OwnsHeader X.header.result B)

/-- Preserve the exact old runner when its chart has the same count and
the actual generated bytes meet the original R58 ordered certificate.
Charge the new physical producer and mount outside that unchanged run. -/
theorem mounted_chart_can_feed_the_exact_existing_group_plan
    (old : MountedChart T) (same : old.count=d+1) (positive : 0<f.natDegree) :
    let known := runRawPhysicalExterior X M F old layout retire B own
    runRawExteriorWithPaidCanonicalChart X d fit bytes covers M F layout retire B own =
      Meter.mk known.result (canonicalTableFee f.natDegree (d+1)+(2+(d+1)*(3*f.natDegree+5))+4+3+known.steps+3) := by
  have one : (mountCanonicalChart T d fit bytes covers).result=old :=
    actual_certified_charts_are_identical_at_equal_count _ _ same.symm
  have eq := raw_runner_consumes_this_actual_mount_once X d fit bytes covers M F layout retire B own positive
  dsimp only at eq ⊢
  rw [one] at eq
  exact eq

end Exterior
#print axioms certified_masks_with_the_same_extent_are_identical
#print axioms actual_certified_charts_are_identical_at_equal_count
#print axioms mounted_chart_can_feed_the_exact_existing_group_plan
end
end J6R110CanonicalMount