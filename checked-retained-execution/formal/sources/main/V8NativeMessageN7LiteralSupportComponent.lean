import V8NativeMessageN7LiteralSupportResidue
import Mathlib.Logic.Relation

/-! Components of the actual partial wiring are generated by a match
between a real row port and a real shifted column port. This is subtler
than the physical group labels: no extra edge is inserted merely for
two vertices sharing a packet or a group. -/
namespace V8NativeMessage.N7LiteralSupport
open scoped Classical Polynomial BigOperators
open Polynomial P11FullPacking J6R10Repack J6R9PacketTiles
set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 7500000
set_option maxRecDepth 2000
noncomputable section

variable {E A B G : Type} [LinearOrder G] [Fintype G]
variable {a : ℕ} {N : Network E A B} (P : PhysicalPacking N a G)

def Wired (t : ℤ) (x y : A⊕B) : Prop :=
  ∃ r q : E,Matches P t r q ∧ x=.inl (N.row r) ∧ y=.inr (N.col q)

abbrev Connected (t : ℤ) := Relation.EqvGen (Wired P t)

theorem true_match_connects_actual_endpoints {t : ℤ} {r q : E} (h : Matches P t r q) :
    Connected P t (.inl (N.row r)) (.inr (N.col q)) :=
  Relation.EqvGen.rel _ _ ⟨r,q,h,rfl,rfl⟩

theorem any_valid_component_class_preserved {I : Type} (t : ℤ) (loc : (A⊕B)→I)
    (ok : ∀ {r q},Matches P t r q→loc (.inl (N.row r))=loc (.inr (N.col q)))
    {v w : A⊕B} (same : Connected P t v w) : loc v=loc w := by
  induction same with
  | rel x y edge =>
    obtain ⟨r,q,hm,hr,hq⟩ := edge
    rw [hr,hq]
    exact ok hm
  | refl _ => rfl
  | symm _ _ _ hi => exact hi.symm
  | trans _ _ _ _ _ h₁ h₂ => exact h₁.trans h₂

variable [Fintype E]

def componentWord (t : ℤ) (v : A⊕B) (y : E→Bool) : ParentPorts N v→Bool :=
  fun p=>Sum.elim (fun r=>readTrueShift P t r y) y p.val

theorem actual_rewired_vertex_depends_only_inside_component
    (t : ℤ) (v : A⊕B) (y y' : E→Bool)
    (same : ∀ q,Connected P t v (.inr (N.col q))→y q=y' q) :
    componentWord P t v y=componentWord P t v y' := by
  funext p
  obtain ⟨p,owned⟩ := p
  cases p with
  | inl r =>
    change (.inl (N.row r) : A⊕B)=v at owned
    change readTrueShift P t r y=readTrueShift P t r y'
    unfold readTrueShift
    split
    · rename_i h
      apply same
      rw [←owned]
      exact true_match_connects_actual_endpoints P (Classical.choose_spec h)
    · rfl
  | inr q =>
    change (.inr (N.col q) : A⊕B)=v at owned
    change y q=y' q
    apply same
    rw [←owned]
    exact Relation.EqvGen.refl _

variable {R : Type} [CommRing R]

theorem unit_wire_is_indicator (b c : Bool) :
    J6NativeHeightResidue.ringEntry (1:R) b c = (if b=c then 1 else 0) := by
  cases b <;> cases c <;> simp [J6NativeHeightResidue.ringEntry]

theorem partial_wiring_sums_exactly_one_row_word
    (A B : (E→Bool)→Bool) (read : E→(E→Bool)→Bool) :
    J6NativeHeightResidue.residueSlot A B read (1:R)=
      ∑ y : E→Bool,bit R (A (fun r=>read r y) && B y) := by
  unfold J6NativeHeightResidue.residueSlot
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun y _=>?_
  let x (r : E) := read r y
  rw [Finset.sum_eq_single x]
  · simp [x,unit_wire_is_indicator,bit]
  · intro z _ a
    have d : ∃ r,z r≠x r := by
      by_contra! h
      exact a (funext h)
    obtain ⟨r,hr⟩ := d
    have kill : (∏ e,J6NativeHeightResidue.ringEntry (1:R) (z e) (read e y))=0 := by
      apply Finset.prod_eq_zero (Finset.mem_univ r)
      rw [unit_wire_is_indicator,if_neg hr]
    simp [kill]
  · simp

end
end V8NativeMessage.N7LiteralSupport
#print axioms V8NativeMessage.N7LiteralSupport.true_match_connects_actual_endpoints
#print axioms V8NativeMessage.N7LiteralSupport.any_valid_component_class_preserved
#print axioms V8NativeMessage.N7LiteralSupport.actual_rewired_vertex_depends_only_inside_component
#print axioms V8NativeMessage.N7LiteralSupport.unit_wire_is_indicator
#print axioms V8NativeMessage.N7LiteralSupport.partial_wiring_sums_exactly_one_row_word
