import V8NativeMessageC2PhysicalCut
import V8NativeMessageC3MainSource

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 3100000

/-! Feed the new sourced C2 cut to the actual C3 assembly and true N8
receiver. Neither application is allowed to switch its D packing, graph,
sign chart, or coordinate between geometry and the lower bound. -/
namespace V8NativeMessage.C2Physical
open scoped Classical BigOperators Polynomial
open V8PooledRange V8PooledRange.NativeOrigin V8PooledMenu.FiveCopy V8NativeMessage.Five
open V8NativeMessage.C3.RawMain V8NativeMessage.C3.RawMain.Combined
noncomputable section

variable {V E : Type} [Fintype V] [Fintype E] {G : Graph V E} {p : ThreePorts G}
variable {P : Packing G p} {i : Fin (rootU V)} {K : Type*}
  [Field K] [LinearOrder K] [IsStrictOrderedRing K] {γ : K}
variable (C : NativeCut P i γ) (hu : 0<rootU V) (huM : rootU V≤wireSize V)
variable {f : ℤ[X]} (probes : Probes V f) (hf : f.Monic) (hd : 0<f.natDegree)

section Main
variable {Γ : Type} {H O : Type*} [Fintype Γ] [Fintype H] [CommRing O] [Algebra O ℚ]
variable (χ : O→+*ZMod 2) (hinj : Function.Injective (algebraMap O ℚ))
variable (files : H→FiveFile (Γ:=Γ) G p) (adr : ∀ h, Address (files h).layout)
    (last : ∀ h, Fin (order (files h).layout)) (b : H→Γ→ℕ)
variable (lists : ∀ h, NativePrivateLists (files h) (adr h) (kept files last h) (b h))
variable (read : ∀ h, V8NativeMessage.C3.Jet ℚ (kept files last h) →ₗ[ℚ] ℚ)
variable (lift : H → Fin 64 → HighChildView P hu huM i f → ℚ)

include hinj hd in
omit [IsStrictOrderedRing K] in
/-- Recover the C3 fixed-list bound on the very matching generated by
C2. Correctness is required of the entire source assembly, not of
individual signed/rational terms. -/
theorem C2_native_C3 (correct : ∀ s : V→Bool, ∃ o : O,
    algebraMap O ℚ o=(∑ h, actualProduct P hu huM i probes hf files adr last b lists read lift h s) ∧
      χ o=(originCount G p s:ZMod 2)) :
    2^C.m≤∑ h,kept files last h*∏ g,b h g := by
  apply C3_source_readout_rank C.pairs P hu huM i C.T probes hf χ hinj
    files adr last b lists read lift hd C.crossing
  intro x y
  exact correct (restrictedSigns C x y)

end Main

variable (L : PublicPrecision V) {b : ℕ}

include hd in
/-- Same generated rows at the N8 receiver, with the genuine native
menu at the selected coordinate and only row-side advice. -/
theorem C2_native_N8 (aux : (Fin C.m→Bool)→Fin b→Bool)
    (dec : (Fin C.m→Bool)→(Fin b→Bool)→FixedMenu P hu huM i L f→ZMod 2)
    (correct : ∀ x y, dec y (aux x) (fixedNative P hu huM i L probes hf (restrictedSigns C x y))=
      (originCount G p (restrictedSigns C x y):ZMod 2)) :
    γ*(Fintype.card V:K)≤68*((fixedBits (rootA V) i (L.prec i)+b:ℕ):K) := by
  have hm := N8_needs_bits C.pairs P hu huM i C.T L probes hf hd C.crossing aux dec correct
  have hmq : (C.m:K)≤((fixedBits (rootA V) i (L.prec i)+b:ℕ):K) := by exact_mod_cast hm
  exact C.match_budget.trans (mul_le_mul_of_nonneg_left hmq (by norm_num))

#print axioms C2_native_C3
#print axioms C2_native_N8
end
end V8NativeMessage.C2Physical
