import V8CapacityMatrixImage
import Mathlib.LinearAlgebra.Dimension.Constructions

/-! The generator count of the nontrivial cyclic factors in A4. Reduce
each factor to the actual local residue field and compare dimensions;
no assumption on the residue-characteristic case is made. -/
namespace V8CapacityGenerator
open scoped Classical BigOperators
open V8CapacityCRTJet

noncomputable section

variable {O : Type*} [CommRing O] [IsLocalRing O]

local notation "κ" => IsLocalRing.ResidueField O

def reduceResidue (π : O) (hz : IsLocalRing.residue O π=0) (t : ℕ) (ht : 0<t) :
    BaseMod O π t →+* κ :=
  Ideal.Quotient.lift (Ideal.span ({π^t}:Set O)) (IsLocalRing.residue O) (by
    intro x hx
    rw [Ideal.mem_span_singleton] at hx
    obtain ⟨y,rfl⟩ := hx
    rw [map_mul,map_pow,hz,zero_pow (Nat.ne_of_gt ht),zero_mul])

theorem reduceResidue_mk (π : O) (hz : IsLocalRing.residue O π=0) (t : ℕ) (ht : 0<t) (x : O) :
    reduceResidue π hz t ht (coeffMod O π t x)=IsLocalRing.residue O x :=
  Ideal.Quotient.lift_mk _ _ _

theorem reduceResidue_surj (π : O) (hz : IsLocalRing.residue O π=0) (t : ℕ) (ht : 0<t) :
    Function.Surjective (reduceResidue π hz t ht) := by
  intro x
  obtain ⟨y,hy⟩ := IsLocalRing.residue_surjective x
  exact ⟨coeffMod O π t y,(reduceResidue_mk π hz t ht y).trans hy⟩

theorem reduceResidue_smul (π : O) (hz : IsLocalRing.residue O π=0) (t : ℕ) (ht : 0<t)
    (r : O) (x : BaseMod O π t) :
    reduceResidue π hz t ht (r • x)=(IsLocalRing.residue O r)*reduceResidue π hz t ht x := by
  obtain ⟨y,rfl⟩ := Ideal.Quotient.mk_surjective x
  change reduceResidue π hz t ht (coeffMod O π t (r*y)) =
    (IsLocalRing.residue O r)*reduceResidue π hz t ht (coeffMod O π t y)
  rw [reduceResidue_mk,reduceResidue_mk,map_mul]

variable {I J : Type*} [Fintype I] [Fintype J]

/-- The product of |I| nonzero cyclic factors cannot be generated by
fewer than |I| vectors. The coefficients allowed to generate are in O. -/
theorem generators_at_least (π : O) (hz : IsLocalRing.residue O π=0)
    (t : I → ℕ) (ht : ∀ i, 0<t i)
    (f : J → ((i : I) → BaseMod O π (t i)))
    (generates : ∀ x : (i : I) → BaseMod O π (t i), ∃ a : J → O, x=∑ j : J, a j • f j) :
    Fintype.card I≤Fintype.card J := by
  let C : Matrix I J κ := Matrix.of fun i j => reduceResidue π hz (t i) (ht i) (f j i)
  let A := C.mulVecLin
  have hSurj : Function.Surjective A := by
    intro z
    choose w hw using (fun i : I => reduceResidue_surj π hz (t i) (ht i) (z i))
    obtain ⟨a,ha⟩ := generates w
    refine ⟨fun j => IsLocalRing.residue O (a j),?_⟩
    funext i
    have h := congrArg (fun x : ((i : I) → BaseMod O π (t i)) =>
      reduceResidue π hz (t i) (ht i) (x i)) ha
    simp only [Finset.sum_apply,Pi.smul_apply,map_sum,reduceResidue_smul] at h
    change (∑ j : J, C i j*(IsLocalRing.residue O (a j)))=z i
    simp only [C,Matrix.of_apply]
    rw [← hw i,h]
    exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)
  have h := LinearMap.finrank_range_le A
  rw [LinearMap.range_eq_top.mpr hSurj,finrank_top,
    Module.finrank_fintype_fun_eq_card,Module.finrank_fintype_fun_eq_card] at h
  exact h

omit [IsLocalRing O] in
/-- Conversely one ordinary coordinate vector per nonzero factor
generates the product. This works even when a factor is zero. -/
theorem coordinate_generates (π : O) (t : I → ℕ) :
    ∀ x : (i : I) → BaseMod O π (t i), ∃ a : I → O,
      x=∑ i : I, a i • (fun j : I => if j=i then (1:BaseMod O π (t j)) else 0) := by
  intro x
  choose a ha using (fun i : I => Ideal.Quotient.mk_surjective (x i))
  refine ⟨a,?_⟩
  funext j
  simp only [Finset.sum_apply,Pi.smul_apply]
  rw [Finset.sum_eq_single_of_mem j (Finset.mem_univ j)]
  · rw [if_pos rfl,Algebra.smul_def,mul_one]
    exact (ha j).symm
  · intro i _ hi
    rw [if_neg (Ne.symm hi),smul_zero]

#print axioms reduceResidue_mk
#print axioms reduceResidue_surj
#print axioms reduceResidue_smul
#print axioms generators_at_least
#print axioms coordinate_generates
end
end V8CapacityGenerator
