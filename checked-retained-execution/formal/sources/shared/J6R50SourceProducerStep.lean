import J6R50SourceProducerKeyed
import J6R50SourceProducerOnline

/-! A real successor at an arbitrary explicit selected chart. The
chart is fixed at the actual source slot; its resident geometry and
the predecessor's next half-port rows are generated by the paid
adapter, not supplied as a second set of descriptors. -/
namespace J6R50SourceProducer
open scoped Classical Polynomial
open Polynomial AOracleMachineTime J6R15ModeCost J6R21Ancestor
open J6R25PreparedSupply J6R26DescriptorTree J6R34ChildPath J6R41StructuredAllPaths
open J6R33StatefulArithmeticPage J6R36ChildFramedRoute J6R27OriginalGate
open J6R10Repack J6R11Blueprint J6R12Blueprint J1PPrinted J6R24MeteredRecursion
open J6ActiveRun P11FullPacking J6R9PacketScopes J6R11Repack
open J6R32ChildResidentTransfer J6R48RawRoute J6R33GeneratedChildSite J6R49SourceLayout
open J6R34RootAtlas J6R16ModeCost
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 3250
set_option maxHeartbeats 11900000
set_option maxSynthPendingDepth 12
set_option linter.unusedSectionVars false
set_option Elab.async false
noncomputable section

variable {f : ℤ[X]} {ell s C key prec tw bw page : ℕ} {cfg : RootBounds s C f}
variable {sel : Selector (printedParams (f:=f) (ell:=ell) s) (sourceDelta s)}
variable {r : Call (PhysicalHost f ell)} {hf : f.Monic}
variable {T : Prepared cfg sel r hf} {v : Ticket sel r}
variable {Q : Birth T v key prec tw bw page}
variable {previous : v.parent.host.Row⊕v.parent.host.Col→Origin key prec page}
variable {S : SiteInputs Q previous}
variable {u : (Plan sel).Slot v.child} {q : ℕ}
variable {U : ExplicitSelectedWords S u q}
local notation "SP" => (printedParams (f:=f) (ell:=ell) s)
local notation "A" => (J6ActiveRun.Shape.levelBits (printedParams (f:=f) (ell:=ell) s) v.child.depth)
local notation "next" => (successorTicket v u)
local notation "d" => (ticketReady T (successorTicket v u))
local notation "t" => (Ticket.centerAt (successorTicket v u))
local notation "p" => (registerPrecision SP v.child t)
local notation "i" => (centerIndex d t)

def selectedAdjacent (R : Replayed S u q U) : LiteralAdjacent S u ((q-A)+13*A) where
  code := childPageKey (q-A)
  raw := R.resident.seats
  exact := R.certificate.seats.trans (congrArg
    (fun xs=>xs.map (physicalSeatField (packing sel d) i (childPageKey (q-A)))) R.orderEq)

structure NativeEventOnly (R : Replayed S u q U) where
  edge : ℕ
  dep : ℕ
  tc : ℕ
  tz : ℕ
  tm : ℕ
  code : ℕ
  native : Meter (NativeWordsOnly T next edge dep prec tc tz tm)
  issued : Meter (Word key)
  fw : List (A1R10.Word p)
  hOld : 0<fw.length
  hMod : A1R10.Modulus p (register_positive d t) fw=NativeProbeRing.liftPoly p f
  words : Meter (ActiveWords fw (q+1) tw bw)
  group : words.result.group=native.result.gWord
  clock : words.result.axis.length=(i).val
  centre : words.result.context.center=(t).val
  codeExact : words.result.context.codeWidth.val=code
  codePos : 0<code
  codeFit : 1+R.certificate.modes.length<2^code
  acted : words.result.exponents.map Word.val=R.certificate.modes.map
    (fun m=>siteTuple sel d (next).slot.val ((packet_mode_equiv (packing sel d).mask i p).symm m))
  outerPos : 0<ell
  fit : (i).val+1≤q+1
  probe : words.result.coordinates.val=List.ofFn (NativeProbeRing.chosenRep f.natDegree
    (realProbeCount (S:=SP) (c:=v.child)) (d).fit (next).probeAt)
  width : (q-A)+13*A=page

def localEventWords {R : Replayed S u q U} (X : NativeEventOnly R) :
    OccurrenceWordsOnly T next key prec tw bw page where
  edge := X.edge
  dep := X.dep
  tc := X.tc
  tz := X.tz
  tm := X.tm
  q := q
  code := X.code
  native := X.native
  issued := X.issued
  fw := X.fw
  hOld := X.hOld
  hMod := X.hMod
  physical := ⟨R.resident,(replayChild S u q U).steps⟩
  geometry := R.certificate
  words := X.words
  group := X.group
  clock := X.clock
  centre := X.centre
  codeExact := X.codeExact
  codePos := X.codePos
  codeFit := X.codeFit
  acted := X.acted
  outerPos := X.outerPos
  fit := X.fit
  probe := X.probe
  width := X.width

def localEventInput {R : Replayed S u q U} (X : NativeEventOnly R) :
    OccurrenceInput T next key prec tw bw page :=
  (localEventWords X).bind (selectedAdjacent R).generated

theorem true_selected_slot_compilation {R : Replayed S u q U} (X : NativeEventOnly R)
    (h : Port v.child.host.Edge) :
    let B := compileOccurrence (localEventInput X)
    (replayChild S u q U).result=some R.resident ∧
      (B.native.physical.record h).body=(S.issuedLane (childHalves T v (edge h)) (side h)).body ∧
      B.job.identifier=X.issued.result ∧ B.job.immutable.payload.stamp.created.val=(next).child.prec ∧
      B.issuance.steps=X.issued.steps+(X.native.steps+(selectedAdjacent R).generated.steps+4+
        (replayChild S u q U).steps+X.words.steps+4) := by
  have e := generated_without_any_old_raw_file (localEventWords X) (selectedAdjacent R).generated
  exact ⟨R.output,next_source_words_realize_adjacent_route (selectedAdjacent R) (localEventWords X) h,
    e.2.1,e.2.2.1,e.2.2.2⟩

section Live
variable (X : StoredSite T v key prec tw bw page)
variable (w : (Plan sel).Slot v.child) {k : ℕ}
variable {V : ExplicitSelectedWords X.site w k}
variable {R : Replayed X.site w k V}

def fromSelected (W : NativeEventOnly R)
    (nextSite : SiteInputs (compileOccurrence (localEventInput W)) X.childOrigins)
    (nextKey : nextSite.pageKey=occurrencePageWord (localEventInput W)) :
    Advance X w :=
  ⟨⟨localEventInput W,X.childOrigins,nextSite,nextKey⟩,rfl,
    fun h=>(true_selected_slot_compilation W h).2.1⟩
end Live

#print axioms selectedAdjacent
#print axioms true_selected_slot_compilation
#print axioms fromSelected
end
end J6R50SourceProducer