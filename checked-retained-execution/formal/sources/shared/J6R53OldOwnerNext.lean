import J6R53OldOwnerBorn
import J6R52CacheSourceReplay

/-! Rekey the actual emitted inherited/fresh metadata for the next
physical site. The next chart's ordered key tape is an explicit
input, checked against that site's actual owner names. -/
namespace J6R53OldOwner
open scoped Polynomial
open Polynomial AOracleMachineTime J6R15ModeCost J6R21Ancestor J6R25PreparedSupply
open J6R26DescriptorTree J6R34ChildPath J6R41StructuredAllPaths
open J6R33StatefulArithmeticPage J6R36ChildFramedRoute J6R27OriginalGate
open J6R10Repack J6R11Blueprint J6R12Blueprint J1PPrinted J6R24MeteredRecursion J6R49SourceLayout
open J6ActiveRun J6R50SourceProducer J6R52CacheSource
set_option autoImplicit false
set_option warningAsError true
set_option linter.unusedSectionVars false
set_option maxRecDepth 3300
set_option maxHeartbeats 13000000
set_option maxSynthPendingDepth 12
set_option Elab.async false
noncomputable section

def rekeyPaid {new gate key prec page : ℕ}
    (paid : Meter (Option (List (OwnerData gate key prec page)))) (keys : List (Word new)) :
    Meter (Option (RawRoster new gate key prec page)) :=
  match paid.result with
  | none=>⟨none,paid.steps+3⟩
  | some rows=>
    let result := setOwnerKeys keys rows
    ⟨result.result,paid.steps+result.steps+5⟩

theorem paid_rekey_actual {V : Type} {new gate key prec page : ℕ}
    (paid : Meter (Option (List (OwnerData gate key prec page))))
    (keys : List (Word new)) (xs : List V) (name : V→Word new) (value : V→OwnerData gate key prec page)
    (bytes : paid.result=some (xs.map value)) (addresses : keys=xs.map name) :
    rekeyPaid paid keys=⟨some (xs.map fun x=>⟨name x,value x⟩),paid.steps+(3+(3*new+6)*xs.length)+5⟩ := by
  unfold rekeyPaid
  rw [bytes,addresses]
  dsimp only
  rw [set_owner_keys_exact]

variable {f : ℤ[X]} {ell s C key prec tw bw page gate : ℕ} {cfg : RootBounds s C f}
variable {sel : Selector (printedParams (f:=f) (ell:=ell) s) (sourceDelta s)}
variable {r : Call (PhysicalHost f ell)} {hf : f.Monic}
variable {T : Prepared cfg sel r hf} {v : Ticket sel r}
local notation "P" => (v.parent.host.Row⊕v.parent.host.Col)
local notation "G" => (Option (CodeGate (Word gate)))

def bornOwnerOrder (X : StoredSite T v key prec tw bw page) (H : ParentOwnerHeaders X.site) :
    List (v.child.host.Row⊕v.child.host.Col) :=
  ((vertexKeysOfBirth X.site (readOldVertices X.site H).result X.canonical).result).order X.site

theorem born_owner_order_full (X : StoredSite T v key prec tw bw page) (H : ParentOwnerHeaders X.site) :
    (bornOwnerOrder X H).Nodup ∧ ∀ u,u∈bornOwnerOrder X H :=
  ((vertexKeysOfBirth X.site (readOldVertices X.site H).result X.canonical).result).valid_order X.site

theorem child_data_is_next_parent_data (X : StoredSite T v key prec tw bw page) (gates : P→G)
    {u : (@Plan f ell s sel).Slot v.child} (advance : Advance X u) :
    childData X gates=parentData advance.next (childGate (T:=T) gates) := by
  funext vtx
  unfold childData parentData
  rw [advance.liveOrigins]

theorem actual_rekey_of_stored_child
    (X : StoredSite T v key prec tw bw page) (gates : P→G)
    (source : CompleteRoster X.site.oldKey (parentData X gates)) (H : ParentOwnerHeaders X.site)
    (inj : Function.Injective X.site.oldKey)
    {u : (@Plan f ell s sel).Slot v.child} (advance : Advance X u)
    (names : List (Word advance.next.site.ownerWidth))
    (aligned : names=(bornOwnerOrder X H).map advance.next.site.oldKey) :
    let out := rekeyPaid (bornOwnerData X gates source H) names
    let order := bornOwnerOrder X H
    let value := parentData advance.next (childGate (T:=T) gates)
    out=⟨some (order.map fun x=>⟨advance.next.site.oldKey x,value x⟩),
      (bornOwnerData X gates source H).steps+(3+(3*advance.next.site.ownerWidth+6)*order.length)+5⟩ := by
  have values : (bornOwnerData X gates source H).result=
      some ((bornOwnerOrder X H).map (parentData advance.next (childGate (T:=T) gates))) := by
    rw [←child_data_is_next_parent_data X gates advance,born_owner_data_actual X gates source H inj]
    rfl
  exact paid_rekey_actual _ names (bornOwnerOrder X H) advance.next.site.oldKey
    (parentData advance.next (childGate (T:=T) gates)) values aligned

/-- This return record keeps the actually generated byte list. The
proof-side typed ordering does not generate runtime keys or payloads. -/
def retainedRosterForNext
    (X : StoredSite T v key prec tw bw page) (gates : P→G)
    (source : CompleteRoster X.site.oldKey (parentData X gates)) (H : ParentOwnerHeaders X.site)
    (inj : Function.Injective X.site.oldKey)
    {u : (@Plan f ell s sel).Slot v.child} (advance : Advance X u)
    (names : List (Word advance.next.site.ownerWidth))
    (aligned : names=(bornOwnerOrder X H).map advance.next.site.oldKey) :
    Meter (CompleteRoster advance.next.site.oldKey (parentData advance.next (childGate (T:=T) gates))) :=
  let order := bornOwnerOrder X H
  let exactOrder := born_owner_order_full X H
  let paid := rekeyPaid (bornOwnerData X gates source H) names
  have out := actual_rekey_of_stored_child X gates source H inj advance names aligned
  let got := unwrapSuccess paid (by
    change (rekeyPaid (bornOwnerData X gates source H) names).result.isSome
    rw [out]
    rfl)
  ⟨⟨order,exactOrder.1,exactOrder.2,got.result,
    congrArg Meter.result (unwrap_success_exact _ _ _ (congrArg Meter.result out))⟩,got.steps⟩

theorem next_roster_charges_only_actual_writes
    (X : StoredSite T v key prec tw bw page) (gates : P→G)
    (source : CompleteRoster X.site.oldKey (parentData X gates)) (H : ParentOwnerHeaders X.site)
    (inj : Function.Injective X.site.oldKey)
    {u : (@Plan f ell s sel).Slot v.child} (advance : Advance X u)
    (names : List (Word advance.next.site.ownerWidth))
    (aligned : names=(bornOwnerOrder X H).map advance.next.site.oldKey) :
    let pay := retainedRosterForNext X gates source H inj advance names aligned
    pay.steps=(bornOwnerData X gates source H).steps+(3+(3*advance.next.site.ownerWidth+6)*names.length)+5 := by
  have len : names.length=(bornOwnerOrder X H).length := by rw [aligned,List.length_map]
  change (rekeyPaid (bornOwnerData X gates source H) names).steps=_
  rw [actual_rekey_of_stored_child X gates source H inj advance names aligned,len]

#print axioms paid_rekey_actual
#print axioms born_owner_order_full
#print axioms child_data_is_next_parent_data
#print axioms actual_rekey_of_stored_child
#print axioms retainedRosterForNext
#print axioms next_roster_charges_only_actual_writes
end
end J6R53OldOwner
