import J7R9EqualityTree

/-!
# Actual half-edge addresses for the subdivided equality tree

Each original internal wire is consumed once at its birth gate and
once at the next gate. The two old incident ports explicitly carry
different sides of the new binary equality. This is generated by
the same caterpillar recursion, not an assumed edge orientation.
-/

namespace J7R9DirectedTree
open J7R9EqualityTree

def halfGates {A : Type*} (external : List (A×Bool)) : List A → List (List (A×Bool))
  | [] => if external.isEmpty then [] else [external]
  | e::es => match external with
    | a::b::rest => [a,b,(e,false)] :: halfGates ((e,true)::rest) es
    | _ => []

theorem forget_sides {A : Type*} (ps : List (A×Bool)) (es : List A) :
    (halfGates ps es).map (List.map Prod.fst) = gates (ps.map Prod.fst) es := by
  induction es generalizing ps with
  | nil => cases ps <;> simp [gates,halfGates]
  | cons e es ih =>
    cases ps with
    | nil => rfl
    | cons p ps =>
      cases ps with
      | nil => rfl
      | cons q ps =>
        simp only [halfGates,gates,List.map_cons]
        rw [ih ((e,true)::ps)]
        rfl

/-- Subdivision with identical values on both sides is semantically
transparent to all the old local gates. -/
theorem same_bit_eval {A : Type*} (x : A → Bool) (ps : List (A×Bool)) (es : List A) :
    (∀ gate ∈ halfGates ps es, agrees (fun q => x q.1) gate) ↔
      ∀ gate ∈ gates (ps.map Prod.fst) es, agrees x gate := by
  have h (g : List (A×Bool)) : agrees (fun q : A×Bool => x q.1) g ↔ agrees x (g.map Prod.fst) := by
    constructor
    · rintro ⟨b,hb⟩
      refine ⟨b,?_⟩
      intro q hq
      obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hq
      exact hb p hp
    · rintro ⟨b,hb⟩
      exact ⟨b,fun p hp => hb _ (List.mem_map.mpr ⟨p,hp,rfl⟩)⟩
  rw [← forget_sides ps es]
  simp [List.mem_map,← h]

theorem two_sides_count {A : Type*} [DecidableEq A] (e x : A) (s : Bool) :
    ([(e,false),(e,true)] : List (A×Bool)).count (x,s) =
      ([e] : List A).count x := by
  by_cases hh : e=x
  · subst e
    cases s <;> simp
  · cases s <;> simp [hh]

/-- Each existing boundary port is carried through with its original
half address, and each internal edge generates precisely one of
each half address. Works even when considering multiplicity. -/
theorem half_multiplicity {A : Type*} [DecidableEq A] (ps : List (A×Bool)) (es : List A)
    (h : shape ps.length es.length) (q : A×Bool) :
    ((halfGates ps es).flatten).count q=ps.count q+es.count q.1 := by
  induction es generalizing ps with
  | nil => cases ps <;> simp [halfGates]
  | cons e es ih =>
    have hh : es.length+1=ps.length-3 := h
    cases ps with
    | nil => simp at hh
    | cons u ps =>
      cases ps with
      | nil => simp at hh
      | cons v ps =>
        have ht : shape (((e,true)::ps).length) es.length := by
          simp only [shape, List.length_cons] at *
          omega
        rw [halfGates,List.flatten_cons,List.count_append,ih _ ht]
        rcases q with ⟨w,s⟩
        have hc := two_sides_count e w s
        simp only [List.count_cons,List.count_nil] at hc ⊢
        omega

theorem half_degree {A : Type*} (ps : List (A×Bool)) (es : List A)
    (h : shape ps.length es.length) :
    ∀ g ∈ halfGates ps es, g.length≤3 := by
  intro g hg
  have hm : g.map Prod.fst ∈ gates (ps.map Prod.fst) es := by
    rw [← forget_sides]
    exact List.mem_map.mpr ⟨g,hg,rfl⟩
  have hs : shape (ps.map Prod.fst).length es.length := by simpa only [List.length_map] using h
  simpa only [List.length_map] using (degree_counts _ _ hs).2.1 _ hm

#print axioms forget_sides
#print axioms same_bit_eval
#print axioms half_multiplicity
#print axioms half_degree

end J7R9DirectedTree

