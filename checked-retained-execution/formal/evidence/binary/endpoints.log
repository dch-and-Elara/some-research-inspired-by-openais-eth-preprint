J6R114PrescribedReceipts.original_ready_fresh_run_counts_and_pays_the_source_clock {V : Type} [DecidableEq V]
  [Fintype V] [Nonempty V] {F : Std.Sat.CNF V} {order : J6R51Ingress.DeclaredOrder V} {h d j r c e base ell kp : ℕ}
  (A : J6R111FreshStartupBinding.RawStartup F order h d j r c e base ell kp)
  (fit :
    base ≤
      J6Mesh.physicalSize (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
          (Paper6SourceSize.sourceNativeSize F order) ^
        2)
  (groups : J6R114PrescribedReceipts.ActualPhysicalStartupPlan A fit)
  (bytes :
    (J6R109CanonicalProbeTable.canonicalTable (J6R52FreshShape.freshFieldResult F order).f.natDegree
          (J6R110CanonicalCoverage.fullProbeDegree (J6R52FreshShape.freshFieldResult F order).f.natDegree + 1)).result =
      J6R110CanonicalMount.OldOrderedBytes (J6R52FreshShape.freshFieldResult F order).f.natDegree
        (J6R110CanonicalCoverage.fullProbeDegree (J6R52FreshShape.freshFieldResult F order).f.natDegree) ⋯)
  (prepCap rootCap : ℕ)
  (data : J6R114PrescribedReceipts.FreshSourcePreparationAndRoots A fit groups bytes prepCap rootCap)
  (basePositive : 0 < base) :
  have boot := J6R111FreshStartupBinding.selectedStartup A fit;
  have D := boot.result.compiled;
  have frame := D.frame;
  have fd := (J6R52FreshShape.freshFieldResult F order).f.natDegree;
  let p := J6SourcePrecision.printed (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)) base;
  have out := J6R114PrescribedReceipts.runFreshPhysicallyRetainedCount A fit groups bytes;
  have caps := J6R114PrescribedReceipts.phaseCapsOnTheFreshOriginalInputs A fit groups bytes prepCap rootCap data;
  have slots :=
    J6R114PrescribedReceipts.actualReceiptSlotRoof
      (J6R114PrescribedReceipts.literalFreshGroupRoof A fit groups bytes caps);
  have pads :=
    (J6R25StableCensus.exactPadOrder (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
        (J6Mesh.K (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
        (J6R24LegalLayout.printedHalf (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
        (J6R28GeneratedRootFrame.constantRootWord
          (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))).length;
  have site :=
    J6R33OriginalJ6.rootSiteFee fd (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
        (J6R14ZeroMode.literalDegree (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
          (Paper6SourceSize.sourceNativeSize F order))
        ell p ⋯ +
      (J6R14ZeroMode.literalDegree (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
            (Paper6SourceSize.sourceNativeSize F order) +
          1) *
        slots;
