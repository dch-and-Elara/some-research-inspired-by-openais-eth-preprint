    out.steps ≤
      boot.steps +
          (J6R25StableCensus.stablePadBudget (J6Mesh.a (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
                  (J6Mesh.K (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
                  (J6R24LegalLayout.printedHalf (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
                  (J6R24LegalLayout.printedRankWidth (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))) +
                J6R25StableCensus.legalRootBudget p
                  (J6R28GeneratedRootFrame.printedFactorWidth
                    (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
                    (J7R10Plant.nSubdiv (J6R51Ingress.guardedInOrder F order.roster)))
                  (J6R28GeneratedRootFrame.printedAnswerWidth
                    (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)) base)
                  ell frame.words.length
                  (J6R24LegalLayout.printedRankWidth (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)) -
                      J6Mesh.a (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)) +
                    13 * J6Mesh.a (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)))
                  (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster)) pads +
              8 +
            J6R33OriginalJ6.gatheredOracleFee (J7R10Plant.nWires (J6R51Ingress.guardedInOrder F order.roster))
              frame.words.length ell p site) +
        5
